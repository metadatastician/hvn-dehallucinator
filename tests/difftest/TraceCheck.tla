---------------------------- MODULE TraceCheck ----------------------------
(* SPDX-License-Identifier: MPL-2.0                                        *)
(* SPDX-FileCopyrightText: 2026 Jonathan D.A. Jewell                       *)
(*                                                                         *)
(* Replays traces recorded from the REAL engine (Traces.tla, generated by  *)
(* tests/difftest/to_tla.sh) against the actions of Engine.tla. A step of  *)
(* a trace is taken only by the Engine.tla action its class names, with    *)
(* the verifier's count pinned to what the stub reported, and only if the  *)
(* observable state afterwards is exactly what the engine wrote. The world *)
(* may move between steps (World). A trace is replayed iff TLC reaches a   *)
(* state with ptr = Len(trace): tests/difftest.sh asserts that for every   *)
(* trace.                                                                  *)
(***************************************************************************)
EXTENDS Engine, Traces, Sequences

VARIABLES tid, ptr
tvars == <<vars, tid, ptr>>

Rec == Tr[tid][ptr + 1]

Pin == Rec[6] = 99 \/ remaining = Rec[6]

Obs == /\ total' = Rec[2] /\ completed' = Rec[3]
       /\ attempts' = Rec[4] /\ status' = Rec[5]

\* InitN chooses its total; `init <n>` must reset to the n it was given.
Act == \/ Rec[1] = "init"     /\ InitN /\ total' = Rec[7]
       \/ Rec[1] = "initfrom" /\ InitFrom
       \/ Rec[1] = "attempt"  /\ Attempt
       \/ Rec[1] = "updm"     /\ UpdateMeasured
       \/ Rec[1] = "updf"     /\ UpdateFailed
       \/ Rec[1] = "ro"       /\ UNCHANGED vars
       \* refuseIfStopped: Engine.tla has no action for a stopped engine, so the
       \* engine refusing (exit 1, state untouched) is a stuttering step.
       \/ Rec[1] = "refused"  /\ status = Stop /\ UNCHANGED vars

TInit == Init /\ tid \in 1 .. Len(Tr) /\ ptr = 0

TNext == \/ World /\ UNCHANGED <<tid, ptr>>
         \/ ptr < Len(Tr[tid]) /\ Pin /\ Act /\ Obs /\ ptr' = ptr + 1 /\ UNCHANGED tid
         \/ ptr = Len(Tr[tid]) /\ UNCHANGED tvars

TSpec == TInit /\ [][TNext]_tvars
=============================================================================
